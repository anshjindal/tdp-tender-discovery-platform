pipeline {
    agent any

    environment {
        NODE_VERSION = '18.17.0'
        NPM_VERSION = '9.6.7'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Lint') {
            steps {
                sh 'npm run lint'
            }
        }

        stage('Run Tests') {
            steps {
                sh 'npm test'
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                
                sh 'kubectl apply -f cicd/team_tdp_203/k8s/'

            
                sh 'kubectl get pods -n team_tdp_203'
            }
        }
    }

    post {
        always {
            echo 'Pipeline completed, including Kubernetes deployment.'
        }
    }
}
