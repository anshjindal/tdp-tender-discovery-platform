{
  "name": "backend",
  "version": "0.0.1",
  "private": true,
  "nx": {
    "name": "backend",
    "projectType": "application",
    "sourceRoot": "apps/backend/src",
    "targets": {
      "serve": {
        "executor": "@nx/js:node",
        "defaultConfiguration": "development",
        "dependsOn": [
          "build"
        ],
        "options": {
          "buildTarget": "backend:build",
          "runBuildTargetDependencies": false
        },
        "configurations": {
          "development": {
            "buildTarget": "backend:build:development"
          },
          "production": {
            "buildTarget": "backend:build:production"
          }
        }
      }
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.48.1",
    "axios": "^1.7.9",
    "compromise": "^14.14.4",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "csv-stringify": "^6.5.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "install": "^0.13.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.9.0",
    "multer": "^1.4.5-lts.1",
    "natural": "^8.0.1",
    "nodemailer": "^6.10.0",
    "openai": "^4.83.0",
    "papaparse": "^5.5.2",
    "pdf-parse": "^1.1.1",
    "vader-sentiment": "^1.1.3"
  },
  "devDependencies": {
    "@types/clamscan": "^2.4.0",
    "@types/cors": "^2.8.17",
    "@types/multer": "^1.4.12",
    "@types/papaparse": "^5.3.15",
    "@types/pg": "^8.11.11",
    "@types/pg-copy-streams": "^1.2.5"
  },
  "scripts": {
    "postinstall": "python -m pip install --no-cache-dir spacy nltk pymupdf python-docx && python -c \"import nltk; nltk.download('vader_lexicon'); nltk.download('punkt')\""
  }
}
